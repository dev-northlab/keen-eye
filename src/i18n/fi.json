    "cases": {
      "cake": {
        "ending": "Se oli koira! Isot mutaiset tassut, pureskeltu tossu ja kerma koirankopin katolla paljastivat sen – se oli niin täynnä kakkua, ettei koskenut omaan ruokaansa. Anteeksi annettu, mutta herkkuja ei tule viikkoon.",
        "intro": "Tänä aamuna keittiön pöydällä oli syntymäpäiväkakku. Nyt jäljellä on vain muruja! Etsi johtolankoja talosta ja pihalta ja selvitä, kuka sen vei.",
        "title": "Kadonnut kakku"
      },
      "cheese": {
        "ending": "Se oli varis! Se lensi sisään kattoikkunasta, nokki juustoa ja kantoi juuston, kolikot ja hopealusikan pesäänsä savupiipun päälle. Kauppias sai kaiken takaisin ja sulkee nyt kattoikkunan öisin.",
        "intro": "Yön aikana iso juustokiekko katosi kaupan tiskiltä ja kiiltävät kolikot sen mukana – silti ovi pysyi riippulukossa. Kuka hiipi sisään?",
        "title": "Juustokaupan arvoitus"
      },
      "circus": {
        "ending": "Se oli taikuri! Hänen oma silinterinsä oli litistynyt, joten hän lainasi sirkustirehtöörin hattua kanitemppuunsa. Hansikkaanjäljet, pelikortit, suippokärkiset kengät ja kaninkarvat paljastivat hänet. Hattu on taas tangossaan, ja esitys jatkuu!",
        "intro": "Tuntia ennen esitystä sirkustirehtöörin silinteri katosi tangostaan. Ei hattua – ei esitystä! Etsi sirkuksesta johtolankoja ja selvitä, kuka sen vei.",
        "title": "Sirkuksen arvoitus"
      },
      "lodge": {
        "ending": "Se oli hiihtäjä! Hän unelmoi voitosta niin paljon, että hiihti yöllä huipulle ottamaan kuvan pokaalin kanssa – ja jätti sen lumiukon käteen. Suksenjäljet, sauvanreiät ja unohtunut suksisauva paljastivat hänet. Hän toi pokaalin takaisin ja voitti kisan reilusti.",
        "intro": "Suurta kisaa edeltävänä yönä kultainen lumihiutalepokaali katosi majan takanreunalta. Kaikki syyttävät jetiä – mutta oliko se todella jeti? Seuraa johtolankoja ylös vuorelle.",
        "title": "Hiihtomajan arvoitus"
      },
      "train": {
        "ending": "Se oli poika! Kiiltävät helmet näyttivät aivan kuulilta, joten hän otti ne leikkiäkseen. Pienet kädenjäljet, pienet kengät, dinosaurustarra ja helmet hänen kuuliensa joukossa paljastivat hänet. Kreivitär nauroi ja antoi hänelle pussillisen oikeita kuulia.",
        "intro": "Yöjunassa kreivittären helmikaulakoru katosi hänen hytistään. Juna ei pysähtynyt kertaakaan – joten se, joka sen vei, on yhä kyydissä.",
        "title": "Yöjunan arvoitus"
      },
      "vase": {
        "ending": "Se oli turisti! Turisti otti askeleen taaksepäin selfietä varten, kaatoi maljakon ja kiiruhti ostamaan liimaa. Lenkkarinjäljet, objektiivin suojus, revennyt hihna ja selfiekeppi kertoivat tarinan. Turisti pyysi anteeksi ja auttoi liimaamaan maljakon takaisin yhteen.",
        "intro": "Museon kuuluisa sininen maljakko on sirpaleina. Joku kaatoi sen ja livahti pois. Seuraa johtolankoja museon läpi.",
        "title": "Rikkoutunut maljakko"
      },
      "chickens": {
        "title": "Kadonneet kanat",
        "intro": "Aamulla kylän tyttö tuli ruokkimaan kanojaan – mutta kanala on tyhjä ja ovi auki! Etsi johtolankoja hänen pihaltaan ja selvitä, kuka päästi kanat karkuun.",
        "ending": "Se oli vuohi! Se nosti sarvillaan kanalan salpaa päästäkseen jyviin ja kaatoi säkin, ja kanat seurasivat varisseita jyviä aina niitylle asti. Sorkanjäljet, kadonnut kello ja jyvät turvassa paljastivat sen. Kaikki kanat ovat kunnossa, ja kanalassa on uusi salpa."
      }
    },
